# OpenTelemetry Configuration for KUB
# Copy to .env and adjust for your environment

# ============================================================================
# OTLP Exporter Configuration
# ============================================================================

# OTLP gRPC endpoint (required for tracing and metrics export)
# Format: hostname:port
# Examples:
#   localhost:4317 (local Jaeger)
#   otel-collector.monitoring.svc.cluster.local:4317 (Kubernetes)
#   otel-collector.example.com:4317 (remote)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# ============================================================================
# SDK Configuration
# ============================================================================

# Disable OpenTelemetry completely (for troubleshooting)
# Set to "true" to disable OTel, "false" to enable
OTEL_SDK_DISABLED=false

# Service identification
# Must match service name in your observability backend
OTEL_SERVICE_NAME=kub

# Service version (should match application version)
OTEL_SERVICE_VERSION=1.0.0

# Deployment environment
# Options: "development", "staging", "production"
# Affects default sampling ratio and log verbosity
OTEL_ENVIRONMENT=development

# ============================================================================
# Tracing Configuration
# ============================================================================

# Sampling ratio (0.0 to 1.0)
# 1.0 = 100% (all traces), 0.1 = 10%, 0.01 = 1%
# Default: 0.1 (10%) for production, 1.0 (100%) for development
OTEL_TRACES_SAMPLE_RATIO=1.0

# ============================================================================
# Metrics Configuration
# ============================================================================

# Metrics export interval (milliseconds)
# Default: 60000ms (60 seconds)
# Typical range: 10000 (10s) to 300000 (5min)
OTEL_METRICS_EXPORT_INTERVAL=60000

# ============================================================================
# Batch Processing Configuration (Internal)
# ============================================================================

# Trace batch processing (configured in code, not environment variable)
# - Batch Timeout: 30 seconds (max wait before flushing spans)
# - Max Batch Size: 256 spans per export
# - Compression: gzip (enabled by default)
# These settings balance network overhead with data freshness

# ============================================================================
# Environment-specific Profiles
# ============================================================================

# DEVELOPMENT Profile (default settings above)
# - Sampling ratio: 100% (capture every trace for debugging)
# - Metrics export interval: 60 seconds
# - Endpoint: localhost:4317 (local Jaeger)
#
# To use: Keep the default settings or explicitly set:
# OTEL_ENVIRONMENT=development
# OTEL_TRACES_SAMPLE_RATIO=1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# STAGING Profile (uncomment to use)
# - Sampling ratio: 50% (balance detail vs storage)
# - Metrics export interval: 60 seconds
# - Endpoint: remote OTEL Collector
#
# OTEL_ENVIRONMENT=staging
# OTEL_TRACES_SAMPLE_RATIO=0.5
# OTEL_METRICS_EXPORT_INTERVAL=60000
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.monitoring:4317

# PRODUCTION Profile (uncomment to use)
# - Sampling ratio: 10% (minimize overhead)
# - Metrics export interval: 60 seconds (or 120 for large clusters)
# - Endpoint: secure OTEL Collector endpoint
#
# OTEL_ENVIRONMENT=production
# OTEL_TRACES_SAMPLE_RATIO=0.1
# OTEL_METRICS_EXPORT_INTERVAL=60000
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.monitoring.svc.cluster.local:4317

# ============================================================================
# Backend Setup Commands
# ============================================================================

# Jaeger (local development with Docker)
# docker run -d \
#   -p 4317:4317 \
#   -p 16686:16686 \
#   jaegertracing/all-in-one:latest
#
# Then access UI at: http://localhost:16686
# Service: kub
# Operations: GET /api/pods, k8s.pods.list, etc.

# OpenTelemetry Collector (for advanced multi-backend setup)
# See https://opentelemetry.io/docs/collector/

# ============================================================================
# Troubleshooting Tips
# ============================================================================

# Check exporter connectivity:
#   telnet localhost 4317
#
# Verify traces in Jaeger:
#   1. Go to http://localhost:16686
#   2. Select service "kub"
#   3. Look for recent traces
#
# If no traces appear:
#   1. Verify exporter endpoint is reachable
#   2. Check OTEL_SDK_DISABLED != true
#   3. Check sampling ratio > 0
#   4. Look for network errors in application logs
#
# High memory usage:
#   1. Reduce OTEL_TRACES_SAMPLE_RATIO (e.g., 0.1 instead of 1.0)
#   2. Increase metrics export interval
#   3. Monitor goroutine count

# ============================================================================
# Collected Metrics Reference
# ============================================================================

# HTTP Metrics (automatic via chi middleware):
#   - http.server.duration (histogram, ms): Request latency
#   - http.server.request.count (counter): Request count
#   - http.server.response.count (counter): Response count

# WebSocket Metrics:
#   - ws.connections.active (updowncounter): Active connections
#   - ws.messages.sent (counter): Messages sent by type
#   - ws.initial_data.latency (histogram, ms): Initial data fetch time
#   - ws.broadcast.errors (counter): Failed broadcast sends

# Kubernetes Client Metrics:
#   - k8s.operation.duration (histogram, ms): K8s API call duration
#   - k8s.operation.count (counter): K8s API call count
#   - k8s.errors (counter): K8s API errors by type

# Watcher Metrics:
#   - watcher.pod.events (counter): Pod watch events
#   - watcher.pod.reconnects (counter): Pod watcher reconnections
#   - watcher.metrics.duration (histogram, ms): Metrics fetch duration
#   - watcher.metrics.errors (counter): Metrics fetch errors
#   - watcher.metrics.fetch.count (counter): Metrics fetch cycles

# Log Streaming Metrics:
#   - logs.lines.streamed (counter): Log lines sent
#   - logs.stream.errors (counter): Stream errors

# Full metrics documentation: backend/internal/models/metrics.go
